# ==============================================================================
# Subly - Environment Variables Configuration Template
# ==============================================================================

# Port for Subly server (Defaults to 3000)
PORT=3000
NODE_ENV=development

# SQLite Database Location (Absolute or relative to runtime)
DATABASE_PATH=artifacts/api-server/data/subly.db

# Resend API Key for dispatching 2FA security login codes (https://resend.com)
# Leave empty to use local test inbox (Ethereal) in development mode
RESEND_API_KEY=

# Custom Sender Email (Defaults to "Subly Security <onboarding@resend.dev>")
MAIL_FROM=Subly Security <onboarding@resend.dev>

# Optional SMTP configuration (if using custom mail server instead of Resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Session secret for cookie/token hashing (Optional, auto-generated if omitted)
SESSION_SECRET=subly_super_secure_session_key_ch_2026
